# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_PRICE_ID_MONTHLY=price_xxx_monthly
STRIPE_PRICE_ID_ANNUAL=price_xxx_annual

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Outscraper (Google Maps review scraping)
OUTSCRAPER_API_KEY=your_outscraper_api_key

# Apify (Yelp + TripAdvisor scraping)
APIFY_TOKEN=your_apify_token

# Cron secret (shared between Vercel cron and the /api/cron routes)
CRON_SECRET=your_random_cron_secret_string

# Resend (transactional email: keyword alerts, weekly digest, payment-failed)
# Required in production. If unset in dev, email sends are skipped with a warning.
RESEND_API_KEY=re_your_resend_api_key

# Optional: override sender addresses per environment. Defaults use replyfi.app.
# FROM_EMAIL_ALERTS=ReplyFi Alerts <alerts@replyfi.app>
# FROM_EMAIL_DIGEST=ReplyFi <digest@replyfi.app>
# FROM_EMAIL_BILLING=ReplyFi <billing@replyfi.app>
